{
  "name": "calendary-tablet",
  "version": "0.1.0",
  "private": true,
  "description": "Wrapper Android (Capacitor) per la vista kiosk di Calendary",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor #05030f --splashBackgroundColor #05030f",
    "apk": "cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
