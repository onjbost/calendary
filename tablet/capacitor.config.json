{
  "appId": "it.gattucciocloud.calendary",
  "appName": "Hubitat",
  "webDir": "www",
  "server": {
    "url": "https://calendary.gattucciocloud.it/kiosk",
    "cleartext": false,
    "errorPath": "index.html",
    "allowNavigation": ["calendary.gattucciocloud.it", "hubitat.gattucciocloud.it"]
  },
  "android": {
    "backgroundColor": "#070605",
    "allowMixedContent": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#00e5ff"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    }
  }
}
